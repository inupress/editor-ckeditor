{
    "name": "inupress/editor-ckeditor",
    "description": "CKEditor 5 for the Inupress admin: replaces the built-in editor in every content field",
    "type": "inupress-plugin",
    "keywords": ["inupress", "inupress-plugin"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "inupress/contracts": "^0.1",
        "inupress/core": "^0.1",
        "filament/filament": "^5.0",
        "kahusoftware/filament-ckeditor-field": "^2.4",
        "spatie/laravel-package-tools": "^1.16"
    },
    "autoload": {
        "psr-4": {
            "Inupress\\EditorCkeditor\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "laravel": {
            "providers": [
                "Inupress\\EditorCkeditor\\EditorCkeditorServiceProvider"
            ]
        }
    }
}
